{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "LaunchInferenceInstance",
      "Effect": "Allow",
      "Action": "ec2:RunInstances",
      "Resource": [
        "arn:aws:ec2:REGION:ACCOUNT_ID:network-interface/*",
        "arn:aws:ec2:REGION:ACCOUNT_ID:subnet/*",
        "arn:aws:ec2:REGION:ACCOUNT_ID:security-group/*",
        "arn:aws:ec2:REGION:ACCOUNT_ID:volume/*"
      ]
    },
    {
      "Sid": "LaunchInferenceInstanceImage",
      "Effect": "Allow",
      "Action": "ec2:RunInstances",
      "Resource": "arn:aws:ec2:REGION::image/*",
      "Condition": {
        "StringEquals": { "ec2:Owner": ["amazon", "ACCOUNT_ID"] }
      }
    },
    {
      "Sid": "LaunchInferenceInstanceType",
      "Effect": "Allow",
      "Action": "ec2:RunInstances",
      "Resource": "arn:aws:ec2:REGION:ACCOUNT_ID:instance/*",
      "Condition": {
        "StringEquals": { "ec2:InstanceType": ["g6.xlarge"] }
      }
    },
    {
      "Sid": "TerminateOwnInstances",
      "Effect": "Allow",
      "Action": "ec2:TerminateInstances",
      "Resource": "arn:aws:ec2:REGION:ACCOUNT_ID:instance/*",
      "Condition": {
        "StringEquals": { "ec2:ResourceTag/App": "image-generator" }
      }
    },
    {
      "Sid": "TagOnLaunchAndObserve",
      "Effect": "Allow",
      "Action": ["ec2:CreateTags", "ec2:DescribeInstances"],
      "Resource": "*"
    },
    {
      "Sid": "PassEc2RoleAtLaunch",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::ACCOUNT_ID:role/image-generator-ec2-role"
    },
    {
      "Sid": "DebugViaSSM",
      "Effect": "Allow",
      "Action": ["ssm:SendCommand", "ssm:GetCommandInvocation"],
      "Resource": "*"
    }
  ]
}
